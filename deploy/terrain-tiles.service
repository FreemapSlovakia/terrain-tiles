# systemd unit for terrain-tiles on fm6.
#
# Install:
#   cp deploy/terrain-tiles.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now terrain-tiles

[Unit]
Description=Freemap terrain tiles (elevation and server-rendered shading)
After=network.target
RequiresMountsFor=/fm/storage1 /fm/storage2

[Service]
Type=simple
User=martin
WorkingDirectory=/fm/storage2/terrain
# Highest priority first; keys are what X-Attribution names as s<key>.
ExecStart=/fm/storage2/terrain/build/target/release/terrain-tiles \
    --listen 127.0.0.1:3040 \
    --cache-mb 2048 \
    --max-age 86400 \
    --elevation-sources /fm/storage1/backend.freemap.sk-data/elevation-sources \
    --source sk=sk.tif \
    --source cz=cz.tif \
    --source ch=ch.tif \
    --source at=at.tif \
    --source de_by=de_by.tif \
    --source de_bw=de_bw.tif \
    --source de_he=de_he.tif \
    --source de_sn=de_sn.tif \
    --source de_th=de_th.tif \
    --source de_nw=de_nw.tif \
    --source de_rp=de_rp.tif \
    --source de_sl=de_sl.tif \
    --source de_ni=de_ni.tif \
    --source de_hb=de_hb.tif \
    --source de_hh=de_hh.tif \
    --source de_sh=de_sh.tif \
    --source de_mv=de_mv.tif \
    --source de_bb=de_bb.tif \
    --source de_st=de_st.tif \
    --source si=si.tif \
    --source hr=hr.tif \
    --source pl=pl.tif \
    --source it=it.tif \
    --source fr=fr.tif \
    --source gedtm30=gedtm30.tif

# Everything else on fm6 matters more: past these, this service is throttled
# and then killed alone rather than the kernel picking a victim.
MemoryHigh=8G
MemoryMax=12G
Nice=5

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
